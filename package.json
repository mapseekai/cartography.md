{
  "name": "cartography.md",
  "version": "0.2.0",
  "private": true,
  "description": "Agent-first format and validator for persistent cartographic design systems.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "pnpm --filter @mapseekai/cartography.md run build",
    "test": "pnpm --filter @mapseekai/cartography.md run test",
    "test:data-profile": "pnpm --filter @cartographymd/data-profile-skill test",
    "typecheck": "pnpm --filter @mapseekai/cartography.md run typecheck",
    "typecheck:data-profile": "pnpm --filter @cartographymd/data-profile-skill typecheck",
    "check": "pnpm run schema:check && pnpm run typecheck && pnpm run typecheck:data-profile && pnpm run test && pnpm run test:data-profile && pnpm run build && pnpm run typecheck:init && pnpm run test:init && pnpm --filter @mapseekai/cartography.md run check-package",
    "schema:generate": "pnpm --filter @mapseekai/cartography.md run schema:generate",
    "schema:check": "pnpm --filter @mapseekai/cartography.md run schema:check",
    "dev": "pnpm --filter @mapseekai/cartography.md run dev",
    "lint:example": "pnpm --filter @mapseekai/cartography.md run dev lint ../../examples/quiet-atlas/CARTOGRAPHY.md --format text",
    "test:init": "pnpm --filter @cartographymd/init-skill test",
    "typecheck:init": "pnpm --filter @cartographymd/init-skill typecheck"
  }
}
