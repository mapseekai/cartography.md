{
  "name": "cartography.md",
  "version": "0.2.0",
  "private": true,
  "description": "An agent-readable cartographic design contract and validator for MapLibre styles.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "pnpm --filter @mapseekai/cartography.md run build",
    "test": "pnpm --filter @mapseekai/cartography.md run test",
    "typecheck": "pnpm --filter @mapseekai/cartography.md run typecheck",
    "check": "pnpm run schema:check && pnpm run typecheck && pnpm run test && pnpm run build && pnpm --filter @mapseekai/cartography.md run check-package",
    "schema:generate": "pnpm --filter @mapseekai/cartography.md run schema:generate",
    "schema:check": "pnpm --filter @mapseekai/cartography.md run schema:check",
    "dev": "pnpm --filter @mapseekai/cartography.md run dev",
    "lint:example": "pnpm --filter @mapseekai/cartography.md run dev lint ../../examples/quiet-atlas/CARTOGRAPHY.md --format text"
  }
}
