{
  "name": "@mapseekai/cartography.md",
  "version": "0.2.0",
  "description": "Agent-first CLI and TypeScript API for validating CARTOGRAPHY.md and MapLibre styles.",
  "keywords": [
    "cartography.md",
    "cartography",
    "maplibre",
    "map-style",
    "design-system",
    "ai-agent",
    "linter"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mapseekai/cartography.md.git"
  },
  "bugs": {
    "url": "https://github.com/mapseekai/cartography.md/issues"
  },
  "homepage": "https://github.com/mapseekai/cartography.md#readme",
  "main": "./dist/api.js",
  "types": "./dist/api.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "cartography.md": "./dist/cli.js",
    "cartographymd": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/api.js",
      "types": "./dist/api.d.ts"
    },
    "./linter": {
      "import": "./dist/linter/index.js",
      "types": "./dist/linter/index.d.ts"
    },
    "./parser": {
      "import": "./dist/parser/index.js",
      "types": "./dist/parser/index.d.ts"
    },
    "./spec": {
      "import": "./dist/spec.js",
      "types": "./dist/spec.d.ts"
    },
    "./schema": {
      "import": "./dist/schema/index.js",
      "types": "./dist/schema/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check-package": "node scripts/check-package.mjs"
  },
  "dependencies": {
    "@maplibre/maplibre-gl-style-spec": "^26.4.1",
    "citty": "^0.1.6",
    "colorjs.io": "^0.7.1",
    "yaml": "^2.7.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.10"
  }
}
