{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mapseek.ai/cartography.md/schema/0.2.0",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "const": "0.2.0"
    },
    "name": {
      "$ref": "#/$defs/__schema0"
    },
    "description": {
      "type": "string"
    },
    "locale": {
      "$ref": "#/$defs/__schema0"
    },
    "tokens": {
      "type": "object",
      "properties": {
        "colors": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        },
        "typography": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "anyOf": [
              {
                "$ref": "#/$defs/__schema1"
              },
              {
                "type": "object",
                "properties": {
                  "fontFamily": {
                    "anyOf": [
                      {
                        "$ref": "#/$defs/__schema0"
                      },
                      {
                        "minItems": 1,
                        "type": "array",
                        "items": {
                          "$ref": "#/$defs/__schema0"
                        }
                      }
                    ]
                  },
                  "fontSize": {
                    "$ref": "#/$defs/__schema2"
                  },
                  "fontWeight": {
                    "anyOf": [
                      {
                        "type": "number",
                        "minimum": 1,
                        "maximum": 1000
                      },
                      {
                        "$ref": "#/$defs/__schema0"
                      }
                    ]
                  },
                  "lineHeight": {
                    "anyOf": [
                      {
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      {
                        "$ref": "#/$defs/__schema2"
                      }
                    ]
                  },
                  "letterSpacing": {
                    "anyOf": [
                      {
                        "type": "number"
                      },
                      {
                        "$ref": "#/$defs/__schema0"
                      }
                    ]
                  }
                },
                "additionalProperties": {}
              }
            ]
          }
        },
        "widths": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema2"
          }
        },
        "sizes": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema2"
          }
        },
        "opacities": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              {
                "$ref": "#/$defs/__schema1"
              }
            ]
          }
        }
      },
      "additionalProperties": {}
    },
    "accessibility": {
      "type": "object",
      "properties": {
        "contrastPairs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/$defs/__schema0"
              },
              "foreground": {
                "$ref": "#/$defs/__schema0"
              },
              "background": {
                "$ref": "#/$defs/__schema0"
              },
              "minimum": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "kind": {
                "type": "string",
                "enum": [
                  "text",
                  "large-text",
                  "graphic"
                ]
              }
            },
            "required": [
              "id",
              "foreground",
              "background",
              "minimum"
            ],
            "additionalProperties": {}
          }
        }
      },
      "additionalProperties": {}
    },
    "omitted": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "$ref": "#/$defs/__schema0"
          },
          {
            "type": "object",
            "properties": {
              "section": {
                "$ref": "#/$defs/__schema0"
              },
              "reason": {
                "$ref": "#/$defs/__schema0"
              }
            },
            "required": [
              "section"
            ],
            "additionalProperties": {}
          }
        ]
      }
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    }
  },
  "required": [
    "version",
    "name"
  ],
  "additionalProperties": {},
  "$defs": {
    "__schema0": {
      "type": "string",
      "pattern": "\\S"
    },
    "__schema1": {
      "type": "string",
      "pattern": "^\\{[A-Za-z0-9_-]+(?:\\[\\d+\\])*(?:\\.[A-Za-z0-9_-]+(?:\\[\\d+\\])*)*\\}$"
    },
    "__schema2": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "string",
          "pattern": "^(?:\\d+(?:\\.\\d+)?|\\.\\d+)(?:px|pt|mm|cm|in|em|rem|%)$"
        },
        {
          "$ref": "#/$defs/__schema1"
        }
      ]
    }
  }
}
